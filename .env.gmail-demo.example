# Gmail CRE live demo
# Copy this file to .env.gmail-demo and replace every CHANGE_ME value.

# Fixed demo accounts. Only the primary account is connected to Toolhouse.
GMAIL_DEMO_PRIMARY_EMAIL=aaditya@toolhouse.ai
GMAIL_DEMO_SECONDARY_EMAIL=aadityasoni2020@gmail.com

# Local MCP backend. Generate the token with: openssl rand -hex 24
GMAIL_DEMO_MCP_TOKEN=CHANGE_ME_RANDOM_48_HEX_CHARACTERS

# Public HTTPS origin created by Cloudflare Tunnel; do not include /toolhouse/mcp.
GMAIL_DEMO_PUBLIC_URL=https://CHANGE_ME.trycloudflare.com

# Google App Password for the secondary Gmail account, not its normal password.
GMAIL_DEMO_SECONDARY_APP_PASSWORD=CHANGE_ME_16_CHARACTER_APP_PASSWORD

# Toolhouse API key plus either the deployed agents.toolhouse.ai URL or a Chat UUID.
TOOLHOUSE_API_KEY=CHANGE_ME_TOOLHOUSE_API_KEY
GMAIL_DEMO_TOOLHOUSE_CHAT_ID=https://agents.toolhouse.ai/CHANGE_ME_AGENT_UUID

# The live runner supplies these as Toolhouse Agent Run variables. Also create
# matching `spreadsheet_id` and `sender_name` variables in Agent Studio so
# scheduled runs work without the CLI.
GMAIL_DEMO_SPREADSHEET_ID=CHANGE_ME_GOOGLE_SHEET_ID
GMAIL_DEMO_SENDER_NAME=Aaditya
